# Individual cells are descriptive observations only.

plot_single_cell <- function(outcome_name) {
  # Cell-level descriptive plot: violin distributions per timepoint/treatment.
  dodge_width <- 0.82
  
  plot_data <- Analysis %>%
    filter(!is.na(.data[[outcome_name]]))
  
  p <- ggplot(
    plot_data,
    aes(
      x = .data[[plot_x_variable]],
      y = .data[[outcome_name]],
      fill = .data[[plot_group_variable]],
      colour = .data[[plot_group_variable]],
      group = interaction(
        .data[[plot_x_variable]],
        .data[[plot_group_variable]],
        drop = TRUE
      )
    )
  ) +
    geom_violin(
      position = position_dodge(width = dodge_width),
      width = 0.9,
      trim = FALSE,
      alpha = 0.35
    ) +
    stat_summary(
      aes(group = interaction(.data[[plot_x_variable]], .data[[plot_group_variable]], drop = TRUE)),
      fun = mean,
      geom = "point",
      position = position_dodge(width = dodge_width),
      shape = 18,
      size = 2.8,
      colour = "black"
    ) +
    geom_point(
      position = position_jitterdodge(
        jitter.width = 0.12,
        jitter.height = 0,
        dodge.width = dodge_width
      ),
      alpha = 0.3,
      size = 1.1,
      show.legend = FALSE
    ) +
    labs(
      title = outcome_name,
      x = plot_x_variable,
      y = outcome_name,
      fill = plot_group_variable,
      colour = plot_group_variable
    ) +
    theme_classic(base_size = 16) +
    scale_fill_manual(
      values = condition_colours,
      drop = FALSE
    ) +
    scale_colour_manual(
      values = condition_colours,
      drop = FALSE
    ) +
    theme(
      axis.text.x = element_text(size = 20),
      axis.text.y = element_text(size = 20),
      axis.title.y = element_text(size = 16),
      strip.text = element_text(size = 16, face = "bold"),
      legend.position = "right"
    )
  
  if (!is.null(plot_stratification)) {
    p <- p + facet_wrap(
      as.formula(paste("~", paste(plot_stratification, collapse = " + ")))
    )
  }
  
  p
}

single_cell_plot_list <- map(
  continuous_outcomes,
  plot_single_cell
)

walk(
  single_cell_plot_list,
  print
)


