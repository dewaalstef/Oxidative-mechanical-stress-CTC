p_to_stars <- function(p) {
  
  case_when(
    is.na(p) ~ "",
    p < 0.001 ~ "***",
    p < 0.01 ~ "**",
    p < 0.05 ~ "*",
    TRUE ~ "ns"
  )
}


make_formula <- function(outcome_name) {
  
  fixed_effects <- paste(
    model_terms,
    collapse = " + "
  )
  
  as.formula(
    paste0(
      outcome_name,
      " ~ ",
      fixed_effects,
      " + (1 | ",
      random_effect,
      ")"
    )
  )
}


make_emmeans_spec <- function() {
  
  if (is.null(comparison_within)) {
    
    as.formula(
      paste0(
        "~ ",
        comparison_variable
      )
    )
    
  } else {
    
    as.formula(
      paste0(
        "~ ",
        comparison_variable,
        " | ",
        paste(
          comparison_within,
          collapse = " * "
        )
      )
    )
  }
}


make_stratum <- function(data, variables) {
  
  if (is.null(variables)) {
    
    return(
      rep(
        "Overall",
        nrow(data)
      )
    )
  }
  
  do.call(
    interaction,
    c(
      data[variables],
      list(
        drop = TRUE,
        sep = " | "
      )
    )
  ) |>
    as.character()
}

safe_dunn_test <- function(data, value_col, group_col) {
  
  dunn <- tryCatch(
    FSA::dunnTest(
      x = data[[value_col]],
      g = droplevels(factor(data[[group_col]])),
      method = "holm"
    ),
    error = function(e) {
      message("Dunn test failed: ", conditionMessage(e))
      NULL
    }
  )
  
  if (is.null(dunn) ||
      is.null(dunn$res) ||
      !is.data.frame(dunn$res) ||
      nrow(dunn$res) == 0) {
    return(tibble(
      contrast = character(),
      estimate = numeric(),
      SE = numeric(),
      df = numeric(),
      statistic = numeric(),
      p.value = numeric(),
      Outcome = character(),
      Test = character(),
      comparison_stratum = character()
    ))
  }
  
  dunn$res %>%
    transmute(
      contrast = Comparison,
      estimate = NA_real_,
      SE = NA_real_,
      df = NA_real_,
      statistic = Z,
      p.value = P.adj,
      Outcome = NA_character_,
      Test = "Dunn-Holm",
      comparison_stratum = NA_character_
    )
}

# ============================================================
# 11. STATISTICAL ANALYSIS FUNCTION
# ============================================================

run_analysis <- function(outcome_name) {
  
  cat(
    "\n--------------------------------------------\n"
  )
  
  cat(
    "Analysing:",
    outcome_name,
    "\n"
  )
  
  model_variables_for_outcome <- unique(
    c(
      outcome_name,
      random_effect,
      model_variables,
      comparison_within
    )
  )
  
  dat <- Analysis_stats %>%
    select(
      all_of(
        model_variables_for_outcome
      )
    ) %>%
    filter(
      !is.na(
        .data[[outcome_name]]
      ),
      !is.na(
        .data[[random_effect]]
      )
    ) %>%
    droplevels()
  
  formula <- make_formula(
    outcome_name
  )
  
  model <- lmer(
    formula,
    data = dat,
    REML = TRUE
  )
  
  residuals_model <- resid(model)
  
  normality_p <- NA_real_
  
  if (
    length(residuals_model) >= 3 &&
    length(residuals_model) <= 5000
  ) {
    
    normality_p <- shapiro.test(
      residuals_model
    )$p.value
  }
  
  use_parametric <- (
    automatic_normality_decision &&
      !is.na(normality_p) &&
      normality_p > normality_alpha
  )
  
  
  # ==========================================================
  # PARAMETRIC BRANCH
  # ==========================================================
  
  if (use_parametric) {
    
    cat(
      "Method: mixed-model ANOVA + Tukey\n"
    )
    
    anova_result <- anova(
      model,
      type = 3
    )
    
    overall <- tibble(
      Outcome = outcome_name,
      Test = "ANOVA",
      normality_p = normality_p,
      Effect = rownames(anova_result),
      statistic = anova_result[, "F value"],
      df_num = anova_result[, "NumDF"],
      df_den = anova_result[, "DenDF"],
      p_value = anova_result[, "Pr(>F)"]
    )
    
    emm <- emmeans(
      model,
      specs = make_emmeans_spec()
    )
    
    pairwise <- as.data.frame(
      contrast(
        emm,
        method = "pairwise",
        adjust = "tukey"
      )
    )
    
    if (is.null(comparison_within)) {
      
      pairwise$comparison_stratum <- "Overall"
      
    } else {
      
      pairwise$comparison_stratum <- make_stratum(
        pairwise,
        comparison_within
      )
    }
    
    pairwise$Outcome <- outcome_name
    pairwise$Test <- "Tukey"
    
    return(
      list(
        model = model,
        data = dat,
        method = "ANOVA",
        
        normality = tibble(
          Outcome = outcome_name,
          normality_p = normality_p
        ),
        
        overall = overall,
        
        emmeans = as.data.frame(
          emm
        ),
        
        pairwise = pairwise
      )
    )
  }
  
  
  # ==========================================================
  # NONPARAMETRIC BRANCH
  # ==========================================================
  
  cat(
    "Method: Kruskal-Wallis + Dunn-Holm\n"
  )
  
  grouping_variables <- unique(
    c(
      random_effect,
      comparison_variable,
      comparison_within
    )
  )
  
  mouse_data <- Analysis_stats %>%
    select(
      all_of(
        c(
          grouping_variables,
          outcome_name
        )
      )
    ) %>%
    filter(
      !is.na(
        .data[[outcome_name]]
      ),
      !is.na(
        .data[[random_effect]]
      )
    ) %>%
    group_by(
      across(
        all_of(
          grouping_variables
        )
      )
    ) %>%
    summarise(
      Value = mean(
        .data[[outcome_name]],
        na.rm = TRUE
      ),
      .groups = "drop"
    ) %>%
    filter(
      is.finite(Value)
    )
  
  
  # ==========================================================
  # OVERALL KRUSKAL-WALLIS + DUNN
  # ==========================================================
  
  if (is.null(comparison_within)) {
    
    kw <- kruskal.test(
      mouse_data$Value ~
        mouse_data[[comparison_variable]]
    )
    
    overall <- tibble(
      Outcome = outcome_name,
      Test = "Kruskal-Wallis",
      normality_p = normality_p,
      Effect = comparison_variable,
      comparison_stratum = "Overall",
      statistic = unname(
        kw$statistic
      ),
      df_num = unname(
        kw$parameter
      ),
      df_den = NA_real_,
      p_value = kw$p.value
    )
    
    pairwise <- safe_dunn_test(
      data = mouse_data,
      value_col = "Value",
      group_col = comparison_variable
    ) %>%
      mutate(
        Outcome = outcome_name,
        comparison_stratum = "Overall"
      )
    
  } else {
    
    
    # ========================================================
    # STRATIFIED KRUSKAL-WALLIS + DUNN
    # ========================================================
    
    mouse_data$comparison_stratum <- make_stratum(
      mouse_data,
      comparison_within
    )
    
    kw_list <- list()
    dunn_list <- list()
    
    for (
      stratum in
      unique(
        mouse_data$comparison_stratum
      )
    ) {
      
      dat_stratum <- mouse_data %>%
        filter(
          comparison_stratum == stratum
        )
      
      if (
        n_distinct(
          dat_stratum[[comparison_variable]]
        ) < 2
      ) {
        next
      }
      
      kw <- kruskal.test(
        dat_stratum$Value ~
          dat_stratum[[comparison_variable]]
      )
      
      kw_list[[stratum]] <- tibble(
        Outcome = outcome_name,
        Test = "Kruskal-Wallis",
        normality_p = normality_p,
        Effect = paste(
          comparison_variable,
          "within",
          stratum
        ),
        comparison_stratum = stratum,
        statistic = unname(
          kw$statistic
        ),
        df_num = unname(
          kw$parameter
        ),
        df_den = NA_real_,
        p_value = kw$p.value
      )
      
      dunn_list[[stratum]] <- safe_dunn_test(
        data = dat_stratum,
        value_col = "Value",
        group_col = comparison_variable
      ) %>%
        mutate(
          Outcome = outcome_name,
          comparison_stratum = stratum
        )
    }
    
    overall <- bind_rows(
      kw_list
    )
    
    pairwise <- bind_rows(
      dunn_list
    )
  }
  
  
  # ==========================================================
  # RETURN NONPARAMETRIC RESULTS
  # ==========================================================
  
  list(
    model = model,
    data = dat,
    method = "Kruskal-Wallis",
    
    normality = tibble(
      Outcome = outcome_name,
      normality_p = normality_p
    ),
    
    overall = overall,
    
    emmeans = NULL,
    
    pairwise = pairwise
  )
}


