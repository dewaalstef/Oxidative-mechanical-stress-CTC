# ============================================================
# 19. PREPARE MOUSE-LEVEL PLOT DATA
# ============================================================

mouse_plot_data <- mouse_means %>%
  pivot_longer(
    cols = all_of(
      continuous_outcomes
    ),
    names_to = "Outcome",
    values_to = "Value"
  )


# ============================================================
# 20. PREPARE SIGNIFICANCE DATA
# ============================================================

sig_comparisons <- model_pairwise_results %>%
  filter(
    !is.na(p.value),
    p.value < 0.05
  ) %>%
  mutate(
    significance = p_to_stars(
      p.value
    )
  )


comparison_levels <- levels(
  droplevels(
    Analysis[[comparison_variable]]
  )
)


pair_lookup <- combn(
  comparison_levels,
  2,
  simplify = FALSE
) %>%
  map_dfr(
    function(x) {
      
      tibble(
        group1 = x[1],
        group2 = x[2],
        
        contrast = paste(
          x[1],
          x[2],
          sep = " - "
        ),
        
        contrast_reverse = paste(
          x[2],
          x[1],
          sep = " - "
        )
      )
    }
  )


# Match standard Tukey/Dunn contrast strings to group labels.

sig_comparisons <- sig_comparisons %>%
  left_join(
    pair_lookup %>%
      select(
        group1,
        group2,
        contrast
      ),
    by = "contrast"
  )


reverse_lookup <- pair_lookup %>%
  select(
    group1_reverse = group1,
    group2_reverse = group2,
    contrast = contrast_reverse
  )


sig_comparisons <- sig_comparisons %>%
  left_join(
    reverse_lookup,
    by = "contrast",
    suffix = c(
      "",
      ".reverse"
    )
  ) %>%
  mutate(
    group1 = coalesce(
      group1,
      group1_reverse
    ),
    
    group2 = coalesce(
      group2,
      group2_reverse
    )
  ) %>%
  select(
    -group1_reverse,
    -group2_reverse
  ) %>%
  mutate(
    x1 = match(
      group1,
      comparison_levels
    ),
    
    x2 = match(
      group2,
      comparison_levels
    )
  ) %>%
  filter(
    !is.na(x1),
    !is.na(x2)
  )


# ============================================================
# 21. MOUSE-LEVEL PLOT FUNCTION
# ============================================================

plot_mouse_level <- function(outcome_name) {
  
  dat <- mouse_plot_data %>%
    filter(
      Outcome == outcome_name
    )
  
  method_for_outcome <-
    analysis_results[[outcome_name]]$method
  
  
  # ----------------------------------------------------------
  # Get overall p-value
  # ----------------------------------------------------------
  
  overall_dat <- overall_results %>%
    filter(
      Outcome == outcome_name
    )
  
  
  # For a simple Treatment model, use the Treatment row.
  # For interaction models, use the comparison variable row.
  #
  # If comparison_variable is not present as an Effect,
  # fall back to the first non-residual effect.
  
  overall_row <- overall_dat %>%
    filter(
      Effect == comparison_variable
    )
  
  if (nrow(overall_row) == 0) {
    
    overall_row <- overall_dat %>%
      filter(
        !str_detect(
          Effect,
          "^Residual"
        )
      ) %>%
      slice(1)
  }
  
  
  if (nrow(overall_row) > 0) {
    
    overall_p <- overall_row$p_value[1]
    
  } else {
    
    overall_p <- NA_real_
  }
  
  
  # ----------------------------------------------------------
  # Format overall p-value
  # ----------------------------------------------------------
  
  format_p <- function(p) {
    
    if (is.na(p)) {
      return("p = NA")
    }
    
    if (p < 0.001) {
      return("p < 0.001")
    }
    
    paste0(
      "p = ",
      format.pval(
        p,
        digits = 3,
        eps = 0.001
      )
    )
  }
  
  
  overall_p_text <- format_p(
    overall_p
  )
  
  
  # ----------------------------------------------------------
  # Method label
  # ----------------------------------------------------------
  
  if (method_for_outcome == "ANOVA") {
    
    subtitle_text <- paste0(
      "ANOVA: ",
      overall_p_text,
      " | Tukey pairwise"
    )
    
  } else {
    
    subtitle_text <- paste0(
      "Kruskal-Wallis: ",
      overall_p_text,
      " | Dunn-Holm pairwise"
    )
  }
  
  
  # ----------------------------------------------------------
  # Base plot
  # ----------------------------------------------------------
  
  # Mouse-level summaries: box plots show the distribution of
  # mouse means; overlaid points show individual mice.
  dodge_width <- 0.78
  
  p <- ggplot(
    dat %>% filter(!is.na(Value)),
    aes(
      x = .data[[plot_x_variable]],
      y = Value,
      fill = .data[[plot_group_variable]],
      colour = .data[[plot_group_variable]],
      group = interaction(
        .data[[plot_x_variable]],
        .data[[plot_group_variable]],
        drop = TRUE
      )
    )
  ) +
    geom_boxplot(
      position = position_dodge(width = dodge_width),
      width = 0.62,
      outlier.shape = NA,
      alpha = 0.25
    ) +
    geom_point(
      position = position_jitterdodge(
        jitter.width = 0.06,
        jitter.height = 0,
        dodge.width = dodge_width
      ),
      size = 3,
      alpha = 0.85
    ) +
    stat_summary(
      aes(group = interaction(
        .data[[plot_x_variable]],
        .data[[plot_group_variable]],
        drop = TRUE
      )),
      fun = mean,
      geom = "point",
      position = position_dodge(width = dodge_width),
      shape = 18,
      size = 4,
      colour = "black"
    ) +
    labs(
      title = outcome_name,
      subtitle = subtitle_text,
      x = plot_x_variable,
      y = outcome_name,
      fill = plot_group_variable,
      colour = plot_group_variable
    ) +
    theme_classic(base_size = 14) +
    scale_fill_manual(
      values = condition_colours,
      drop = FALSE
    ) +
    scale_colour_manual(
      values = condition_colours,
      drop = FALSE
    ) +
    theme(
      axis.text.x = element_text(size = 20),
      axis.text.y = element_text(size = 20),
      axis.title.y = element_text(size = 14),
      plot.subtitle = element_text(size = 16),
      strip.text = element_text(size = 14, face = "bold"),
      legend.position = "right"
    )
  
  # ----------------------------------------------------------
  # Add facets if requested
  # ----------------------------------------------------------
  
  if (!is.null(plot_stratification)) {
    
    p <- p +
      facet_wrap(
        as.formula(
          paste(
            "~",
            paste(
              plot_stratification,
              collapse = " + "
            )
          )
        )
      )
  }
  
  
  # ----------------------------------------------------------
  # Pairwise significance data
  # ----------------------------------------------------------
  
  sig_dat <- sig_comparisons %>%
    filter(
      Outcome == outcome_name
    )
  
  if (nrow(sig_dat) == 0) {
    return(p)
  }
  
  # For timepoint-on-x plots with treatments dodged within each
  # timepoint, show pairwise brackets only at the stats timepoint.
  if (!identical(plot_x_variable, comparison_variable)) {
    
    if (identical(plot_x_variable, "Timepoint_hours") &&
        identical(plot_group_variable, comparison_variable) &&
        identical(comparison_variable, "Treatment")) {
      
      time_levels <- levels(droplevels(dat[[plot_x_variable]]))
      treatment_levels <- levels(droplevels(dat[[plot_group_variable]]))
      
      if (!(stats_timepoint %in% time_levels) ||
          length(treatment_levels) < 2) {
        return(p)
      }
      
      time_index <- match(stats_timepoint, time_levels)
      n_treatments <- length(treatment_levels)
      
      dodge_offset <- function(treatment) {
        (match(treatment, treatment_levels) -
           (n_treatments + 1) / 2) * dodge_width / n_treatments
      }
      
      sig_dat <- sig_dat %>%
        filter(
          group1 %in% treatment_levels,
          group2 %in% treatment_levels
        ) %>%
        mutate(
          x1 = time_index + vapply(group1, dodge_offset, numeric(1)),
          x2 = time_index + vapply(group2, dodge_offset, numeric(1))
        )
      
      if (nrow(sig_dat) == 0) {
        return(p)
      }
      
      y_vals <- dat$Value[!is.na(dat$Value)]
      if (length(y_vals) == 0) {
        return(p)
      }
      y_max <- max(y_vals)
      y_min <- min(y_vals)
      y_range <- y_max - y_min
      if (!is.finite(y_range) || y_range == 0) {
        y_range <- abs(y_max) * 0.1 + 1
      }
      
      sig_dat <- sig_dat %>%
        arrange(x1, x2) %>%
        mutate(
          y_range = y_range,
          y_position = y_max + y_range * (0.08 + 0.10 * (row_number() - 1))
        )
      
      return(
        p +
          geom_segment(
            data = sig_dat,
            aes(x = x1, xend = x2, y = y_position, yend = y_position),
            inherit.aes = FALSE,
            colour = "black"
          ) +
          geom_segment(
            data = sig_dat,
            aes(x = x1, xend = x1, y = y_position,
                yend = y_position - 0.025 * y_range),
            inherit.aes = FALSE,
            colour = "black"
          ) +
          geom_segment(
            data = sig_dat,
            aes(x = x2, xend = x2, y = y_position,
                yend = y_position - 0.025 * y_range),
            inherit.aes = FALSE,
            colour = "black"
          ) +
          geom_text(
            data = sig_dat,
            aes(x = (x1 + x2) / 2,
                y = y_position + 0.025 * y_range,
                label = significance),
            inherit.aes = FALSE,
            colour = "black",
            size = 5
          )
      )
    }
    
    return(p)
  }
  
  # ----------------------------------------------------------
  # Determine plot strata
  # ----------------------------------------------------------
  
  if (!is.null(comparison_within)) {
    
    dat$plot_stratum <- make_stratum(
      dat,
      plot_stratification
    )
    
    sig_dat$plot_stratum <-
      sig_dat$comparison_stratum
    
  } else if (!is.null(plot_stratification)) {
    
    dat$plot_stratum <- make_stratum(
      dat,
      plot_stratification
    )
    
    # Overall comparison cannot safely be repeated in every facet.
    return(p)
    
  } else {
    
    dat$plot_stratum <- "Overall"
    
    sig_dat$plot_stratum <- "Overall"
  }
  
  
  # ----------------------------------------------------------
  # Calculate y-axis positions
  # ----------------------------------------------------------
  
  y_ranges <- dat %>%
    group_by(
      plot_stratum
    ) %>%
    summarise(
      y_max = max(
        Value,
        na.rm = TRUE
      ),
      
      y_min = min(
        Value,
        na.rm = TRUE
      ),
      
      .groups = "drop"
    ) %>%
    mutate(
      y_range = y_max - y_min,
      
      y_range = ifelse(
        y_range == 0 |
          is.na(y_range),
        
        abs(y_max) * 0.1 + 1,
        
        y_range
      )
    )
  
  
  sig_dat <- sig_dat %>%
    left_join(
      y_ranges,
      by = "plot_stratum"
    ) %>%
    group_by(
      plot_stratum
    ) %>%
    arrange(
      x1,
      x2,
      .by_group = TRUE
    ) %>%
    mutate(
      y_position =
        y_max +
        y_range * (
          0.08 +
            0.10 *
            (row_number() - 1)
        )
    ) %>%
    ungroup()
  
  
  # ----------------------------------------------------------
  # Add significance bars
  # ----------------------------------------------------------
  
  p +
    
    geom_segment(
      data = sig_dat,
      
      aes(
        x = x1,
        xend = x2,
        y = y_position,
        yend = y_position
      ),
      
      inherit.aes = FALSE,
      colour = "black"
    ) +
    
    geom_segment(
      data = sig_dat,
      
      aes(
        x = x1,
        xend = x1,
        y = y_position,
        yend =
          y_position -
          0.025 * y_range
      ),
      
      inherit.aes = FALSE,
      colour = "black"
    ) +
    
    geom_segment(
      data = sig_dat,
      
      aes(
        x = x2,
        xend = x2,
        y = y_position,
        yend =
          y_position -
          0.025 * y_range
      ),
      
      inherit.aes = FALSE,
      colour = "black"
    ) +
    
    geom_text(
      data = sig_dat,
      
      aes(
        x = (x1 + x2) / 2,
        
        y =
          y_position +
          0.025 * y_range,
        
        label = significance
      ),
      
      inherit.aes = FALSE,
      colour = "black",
      size = 5
    )
}


