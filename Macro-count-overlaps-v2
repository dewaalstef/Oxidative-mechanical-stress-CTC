// Version 2 of counting overlapping tumor nucleus-based expansion zones
// and CD45+ cells

// ---- SETTINGS ----
g1Count = 8;		// <<< IMPORTANT TO CHANGE THIS TO THE NUMBER OF TUMOR CELL ROIs
n = roiManager("count");

// Clear any previous results
run("Clear Results");

row = 0;

for (i = 0; i < g1Count; i++) {

    roiManager("select", i);
    getSelectionBounds(x1, y1, w1, h1);

    touchCount = 0;

    for (j = g1Count; j < n; j++) {

        roiManager("select", j);
        getSelectionBounds(x2, y2, w2, h2);

        // bounding box rejection
        if (x1 > x2 + w2 || x2 > x1 + w1 ||
            y1 > y2 + h2 || y2 > y1 + h1) {
            continue;
        }

        found = 0;

        roiManager("select", j);
        getSelectionBounds(x2, y2, w2, h2);

        for (x = x2; x <= x2 + w2 && found == 0; x++) {
            for (y = y2; y <= y2 + h2; y++) {

                if (!selectionContains(x, y))
                    continue;

                roiManager("select", i);
                if (selectionContains(x, y)) {
                    touchCount++;
                    found = 1;
                    break;
                }
            }
        }
    }

    // ---- WRITE TO TABLE ----
    setResult("Tumour_ROI", row, i + 1);
    setResult("CD45+_cells", row, touchCount);
    row++;
}

// Show final table
updateResults();
