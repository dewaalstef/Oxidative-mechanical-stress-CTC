# ============================================================

phenotype_untreated_means <- phenotype_long %>%
  filter(
    Test == "Untreated"
  ) %>%
  group_by(
    Phenotype
  ) %>%
  summarise(
    untreated_mean = mean(
      Percentage,
      na.rm = TRUE
    ),
    .groups = "drop"
  )


phenotype_treatment_means <- phenotype_long %>%
  group_by(
    Phenotype,
    Test
  ) %>%
  summarise(
    mean_percentage = mean(
      Percentage,
      na.rm = TRUE
    ),
    .groups = "drop"
  )


phenotype_effects <- phenotype_treatment_means %>%
  left_join(
    phenotype_untreated_means,
    by = "Phenotype"
  ) %>%
  mutate(
    difference_from_untreated =
      mean_percentage - untreated_mean
  ) %>%
  filter(
    Test != "Untreated"
  )

