# 25. EFFECT SIZE / DIFFERENCE FROM UNTREATED
#
# Main outcome:
# difference between each treatment mean and the overall
# Untreated mean.
# ============================================================

untreated_means <- shearstressdata %>%
  filter(
    Test == "Untreated"
  ) %>%
  summarise(
    untreated = mean(
      percent_decrease_cell_count,
      na.rm = TRUE
    )
  )


effect_summary <- shearstressdata %>%
  group_by(Test) %>%
  summarise(
    value = mean(
      percent_decrease_cell_count,
      na.rm = TRUE
    ),
    .groups = "drop"
  ) %>%
  mutate(
    untreated = untreated_means$untreated,
    difference_from_untreated =
      value - untreated
  ) %>%
  filter(
    Test != "Untreated"
  )

