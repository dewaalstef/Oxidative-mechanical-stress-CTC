# ============================================================
# 12. FUNCTION FOR PAIRWISE STATISTICAL ANNOTATIONS
#
# Shows ALL significant pairwise comparisons.
#
# ANOVA:
#   Tukey-adjusted
#
# Kruskal-Wallis:
#   Dunn + Holm-adjusted
# ============================================================

add_stat_annotations <- function(
    plot,
    data,
    outcome,
    anova_table,
    pairwise_table
) {
  
  
  dat <- data %>%
    select(
      Test,
      all_of(outcome)
    ) %>%
    rename(
      Value = all_of(outcome)
    ) %>%
    filter(
      !is.na(Value)
    )
  
  
  dat$Test <- droplevels(dat$Test)
  
  
  # ----------------------------------------------------------
  # Overall test information
  # ----------------------------------------------------------
  
  overall_result <- anova_table %>%
    filter(
      Outcome == outcome
    )
  
  
  if (nrow(overall_result) == 0) {
    
    test_method <- "Statistical test"
    overall_p <- NA_real_
    
  } else {
    
    test_method <- overall_result$test_method[1]
    overall_p <- overall_result$p_value[1]
    
  }
  
  
  # ----------------------------------------------------------
  # Dynamic overall-test label
  # ----------------------------------------------------------
  
  if (test_method == "ANOVA") {
    
    test_name <- "ANOVA"
    
  } else if (test_method == "Kruskal-Wallis") {
    
    test_name <- "Kruskal-Wallis"
    
  } else {
    
    test_name <- test_method
    
  }
  
  
  if (is.na(overall_p)) {
    
    overall_label <- paste0(
      test_name,
      ": p = NA"
    )
    
  } else if (overall_p < 0.001) {
    
    overall_label <- paste0(
      test_name,
      ": p < 0.001"
    )
    
  } else {
    
    overall_label <- paste0(
      test_name,
      ": p = ",
      format.pval(
        overall_p,
        digits = 3,
        eps = 0.001
      )
    )
    
  }
  
  
  # ----------------------------------------------------------
  # ALL significant pairwise comparisons
  #
  # p.value is already adjusted:
  #
  # ANOVA       -> Tukey
  # Kruskal     -> Dunn + Holm
  # ----------------------------------------------------------
  
  stats <- pairwise_table %>%
    filter(
      Outcome == outcome,
      !is.na(p.value),
      p.value <= 0.05
    ) %>%
    mutate(
      significance = p_to_stars(p.value)
    )
  
  
  # ----------------------------------------------------------
  # Convert treatment names to x-axis positions
  # ----------------------------------------------------------
  
  if (nrow(stats) > 0) {
    
    stats <- stats %>%
      mutate(
        x1 = match(
          group1,
          levels(dat$Test)
        ),
        x2 = match(
          group2,
          levels(dat$Test)
        )
      ) %>%
      filter(
        !is.na(x1),
        !is.na(x2)
      ) %>%
      mutate(
        x_min = pmin(x1, x2),
        x_max = pmax(x1, x2)
      )
    
    
    # --------------------------------------------------------
    # Calculate bracket heights
    # --------------------------------------------------------
    
    y_max <- max(
      dat$Value,
      na.rm = TRUE
    )
    
    y_min <- min(
      dat$Value,
      na.rm = TRUE
    )
    
    y_range <- y_max - y_min
    
    if (y_range == 0) {
      y_range <- 1
    }
    
    
    bracket_step <- max(
      y_range * 0.10,
      1
    )
    
    
    bracket_height <- max(
      y_range * 0.025,
      0.25
    )
    
    
    # --------------------------------------------------------
    # Arrange brackets
    # --------------------------------------------------------
    
    stats <- stats %>%
      arrange(
        x_min,
        x_max
      )
    
    
    # --------------------------------------------------------
    # Assign vertical positions
    # --------------------------------------------------------
    
    stats <- stats %>%
      mutate(
        y =
          y_max +
          seq_len(n()) * bracket_step,
        
        y_text =
          y +
          bracket_height
      )
    
    
    # --------------------------------------------------------
    # Add brackets
    # --------------------------------------------------------
    
    plot <- plot +
      
      geom_segment(
        data = stats,
        aes(
          x = x_min,
          xend = x_max,
          y = y,
          yend = y
        ),
        inherit.aes = FALSE,
        colour = "black",
        linewidth = 1.6
      ) +
      
      geom_segment(
        data = stats,
        aes(
          x = x_min,
          xend = x_min,
          y = y,
          yend = y - bracket_height
        ),
        inherit.aes = FALSE,
        colour = "black",
        linewidth = 1.6
      ) +
      
      geom_segment(
        data = stats,
        aes(
          x = x_max,
          xend = x_max,
          y = y,
          yend = y - bracket_height
        ),
        inherit.aes = FALSE,
        colour = "black",
        linewidth = 1.6
      ) +
      
      geom_text(
        data = stats,
        aes(
          x = (x_min + x_max) / 2,
          y = y_text,
          label = significance
        ),
        inherit.aes = FALSE,
        size = 10
      )
    
  }
  
  
  # ----------------------------------------------------------
  # Determine upper plotting limit
  # ----------------------------------------------------------
  
  if (nrow(stats) > 0) {
    
    upper_limit <- max(
      max(dat$Value, na.rm = TRUE),
      max(stats$y_text, na.rm = TRUE)
    ) + bracket_step
    
  } else {
    
    y_max <- max(
      dat$Value,
      na.rm = TRUE
    )
    
    y_min <- min(
      dat$Value,
      na.rm = TRUE
    )
    
    y_range <- y_max - y_min
    
    if (y_range == 0) {
      y_range <- 1
    }
    
    upper_limit <- y_max + y_range * 0.10
    
  }
  
  
  # ----------------------------------------------------------
  # Add overall-test label and final y-limit
  # ----------------------------------------------------------
  
  plot +
    annotate(
      "text",
      x = 1,
      y = upper_limit,
      label = overall_label,
      hjust = 0,
      vjust = 1,
      size = 35 / ggplot2::.pt
    ) +
    coord_cartesian(
      ylim = c(
        NA,
        upper_limit
      ),
      clip = "off"
    )
}


# ============================================================
# 13. MAIN PLOT FUNCTION
#
# Individual observations + mean + SEM +
# overall statistical test +
# ALL significant pairwise comparisons.
# ============================================================

plot_outcome <- function(
    data,
    outcome,
    y_label,
    anova_table,
    pairwise_table
) {
  
  
  dat <- data %>%
    select(
      Test,
      all_of(outcome)
    ) %>%
    rename(
      Value = all_of(outcome)
    ) %>%
    filter(
      !is.na(Value)
    )
  
  
  dat$Test <- droplevels(dat$Test)
  
  
  summary_dat <- dat %>%
    group_by(Test) %>%
    summarise(
      n = n(),
      mean = mean(Value),
      sd = sd(Value),
      sem = sd / sqrt(n),
      .groups = "drop"
    )
  
  
  p <- ggplot(
    dat,
    aes(
      x = Test,
      y = Value
    )
  ) +
    
  # --------------------------------------------------------
  # Individual observations
  # --------------------------------------------------------
  
  geom_jitter(
    aes(
      fill = Test
    ),
    shape = 21,
    colour = "black",
    width = 0.08,
    height = 0,
    size = 8,
    alpha = 0.85
  ) +
    scale_fill_manual(
      values = treatment_colours,
      drop = TRUE
    ) +
    
    
  # --------------------------------------------------------
  # Mean
  # --------------------------------------------------------
  
  geom_point(
    data = summary_dat,
    aes(
      x = Test,
      y = mean
    ),
    inherit.aes = FALSE,
    shape = 18,
    size = 6,
    colour = "black"
  ) +
    
    
  # --------------------------------------------------------
  # SEM
  # --------------------------------------------------------
  
  geom_errorbar(
    data = summary_dat,
    aes(
      x = Test,
      ymin = mean - sem,
      ymax = mean + sem
    ),
    inherit.aes = FALSE,
    width = 0.12,
    linewidth = 1.6,
    colour = "black"
  ) +
    
    
  # --------------------------------------------------------
  # Theme
  # --------------------------------------------------------
  
  theme_minimal() +
    
    labs(
      x = "Treatment",
      y = y_label
    ) +
    
    theme(
      axis.text.x = element_text(
        size = 0,
        angle = 45,
        hjust = 1
      ),
      axis.text.y = element_text(
        size = 35
      ),
      axis.title.x = element_text(
        size = 35
      ),
      axis.title.y = element_text(
        size = 35
      ),
      panel.grid.minor = element_blank(),
      axis.line = element_line(
        colour = "black",
        linewidth = 1.6
      ),
      axis.ticks = element_line(
        colour = "black",
        linewidth = 0.5
      ),
      legend.position = "none",
      # legend.position = c(0.98, 0.98),
      # legend.justification = c("right", "top"),
      # legend.background = element_rect(
