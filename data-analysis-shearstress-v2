# ============================================================
# 8. AUTOMATIC STATISTICAL TEST SELECTION
#
# Workflow:
#
# 1. Fit Value ~ Test
# 2. Check normality of model residuals using Shapiro-Wilk
# 3. If residuals are reasonably normal:
#       -> one-way ANOVA
#       -> Tukey-adjusted all-pairwise comparisons
#
# 4. If residuals are not reasonably normal:
#       -> Kruskal-Wallis
#       -> Dunn's multiple comparisons test
#          with Holm adjustment
#
# IMPORTANT:
# Normality is assessed on MODEL RESIDUALS rather than
# separately within each treatment group.
#
# ============================================================



run_model <- function(data, outcome) {
  
  dat <- data %>%
    select(
      Test,
      all_of(outcome)
    ) %>%
    rename(
      Value = all_of(outcome)
    ) %>%
    filter(
      !is.na(Value)
    )
  
  
  # Remove unused treatment levels
  
  dat$Test <- droplevels(dat$Test)
  
  
  # ----------------------------------------------------------
  # Linear model
  # ----------------------------------------------------------
  
  model <- lm(
    Value ~ Test,
    data = dat
  )
  
  
  # ----------------------------------------------------------
  # Normality of model residuals
  #
  # Shapiro-Wilk is applied to the residuals of the model,
  # not separately to each treatment.
  # ----------------------------------------------------------
  
  residuals_model <- residuals(model)
  
  
  if (
    length(residuals_model) >= 3 &&
    length(residuals_model) <= 5000
  ) {
    
    shapiro_result <- shapiro.test(
      residuals_model
    )
    
    normality_p <- shapiro_result$p.value
    
  } else {
    
    normality_p <- NA_real_
    
  }
  
  
  # ----------------------------------------------------------
  # Decide which statistical framework to use
  # ----------------------------------------------------------
  
  # If normality cannot be assessed, use the non-parametric
  # approach rather than automatically assuming normality.
  
  use_anova <- !is.na(normality_p) &&
    normality_p > 0.05
  
  
  # ==========================================================
  # PARAMETRIC BRANCH
  # ==========================================================
  
  if (use_anova) {
    
    
    # --------------------------------------------------------
    # One-way ANOVA
    # --------------------------------------------------------
    
    treatment_anova <- anova(model)
    
    treatment_result <- tibble(
      Outcome = outcome,
      test_method = "ANOVA",
      normality_p = normality_p,
      statistic = treatment_anova["Test", "F value"],
      df = treatment_anova["Test", "Df"],
      p_value = treatment_anova["Test", "Pr(>F)"]
    )
    
    
    # --------------------------------------------------------
    # Estimated marginal means
    # --------------------------------------------------------
    
    emm <- emmeans(
      model,
      ~ Test
    )
    
    
    # --------------------------------------------------------
    # ALL pairwise comparisons
    #
    # Tukey adjustment is used because there are many
    # pairwise treatment comparisons.
    # --------------------------------------------------------
    
    pairwise_raw <- contrast(
      emm,
      method = "pairwise",
      adjust = "tukey"
    ) %>%
      as.data.frame() %>%
      as_tibble()
    
    
    # --------------------------------------------------------
    # Construct treatment pairs directly from factor levels.
    #
    # This avoids problems with special characters such as "+"
    # appearing in treatment names.
    # --------------------------------------------------------
    
    treatment_levels <- levels(dat$Test)
    
    expected_pairs <- combn(
      treatment_levels,
      2,
      simplify = FALSE
    )
    
    expected_group1 <- map_chr(
      expected_pairs,
      ~ .x[1]
    )
    
    expected_group2 <- map_chr(
      expected_pairs,
      ~ .x[2]
    )
    
    
    if (nrow(pairwise_raw) != length(expected_pairs)) {
      
      stop(
        paste0(
          "Number of Tukey pairwise comparisons (",
          nrow(pairwise_raw),
          ") does not match the expected number of treatment pairs (",
          length(expected_pairs),
          ")."
        )
      )
      
    }
    
    
    pairwise <- pairwise_raw %>%
      mutate(
        Outcome = outcome,
        test_method = "Tukey",
        group1 = expected_group1,
        group2 = expected_group2
      ) %>%
      select(
        Outcome,
        test_method,
        group1,
        group2,
        contrast,
        estimate,
        SE,
        df,
        t.ratio,
        p.value
      )
    
    
    # --------------------------------------------------------
    # Return results
    # --------------------------------------------------------
    
    return(
      list(
        model = model,
        treatment_result = treatment_result,
        pairwise = pairwise,
        emmeans = as.data.frame(emm),
        normality = tibble(
          Outcome = outcome,
          normality_test = "Shapiro-Wilk on model residuals",
          normality_p = normality_p,
          selected_test = "ANOVA + Tukey"
        )
      )
    )
    
  }
  
  
  # ==========================================================
  # NON-PARAMETRIC BRANCH
  # ==========================================================
  
  
  # ----------------------------------------------------------
  # Kruskal-Wallis test
  # ----------------------------------------------------------
  
  kw_result <- kruskal.test(
    Value ~ Test,
    data = dat
  )
  
  
  treatment_result <- tibble(
    Outcome = outcome,
    test_method = "Kruskal-Wallis",
    normality_p = normality_p,
    statistic = unname(kw_result$statistic),
    df = unname(kw_result$parameter),
    p_value = kw_result$p.value
  )
  
  
  # ----------------------------------------------------------
  # Dunn's multiple comparisons test
  #
  # Holm adjustment is used for the complete family of
  # pairwise comparisons.
  # ----------------------------------------------------------
  
  dunn_raw <- FSA::dunnTest(
    Value ~ Test,
    data = dat,
    method = "holm"
  )$res %>%
    as_tibble()
  
  
  # ----------------------------------------------------------
  # Recover the actual treatment names from the Dunn output.
  #
  # FSA reports comparisons as:
  #
  # Treatment A - Treatment B
  # ----------------------------------------------------------
  
  dunn_pairs <- strsplit(
    as.character(dunn_raw$Comparison),
    " - ",
    fixed = TRUE
  )
  
  
  dunn_group1 <- map_chr(
    dunn_pairs,
    ~ .x[1]
  )
  
  dunn_group2 <- map_chr(
    dunn_pairs,
    ~ .x[2]
  )
  
  
  pairwise <- dunn_raw %>%
    mutate(
      Outcome = outcome,
      test_method = "Dunn",
      group1 = dunn_group1,
      group2 = dunn_group2,
      estimate = NA_real_,
      SE = NA_real_,
      df = NA_real_,
      t.ratio = Z,
      p.value = P.adj
    ) %>%
    select(
      Outcome,
      test_method,
      group1,
      group2,
      Comparison,
      estimate,
      SE,
      df,
      t.ratio,
      p.value,
      P.unadj,
      P.adj
    )
  
  
  # ----------------------------------------------------------
  # Return results
  # ----------------------------------------------------------
  
  list(
    model = model,
    treatment_result = treatment_result,
    pairwise = pairwise,
    emmeans = NULL,
    normality = tibble(
      Outcome = outcome,
      normality_test = "Shapiro-Wilk on model residuals",
      normality_p = normality_p,
      selected_test = "Kruskal-Wallis + Dunn"
    )
  )
  
}


