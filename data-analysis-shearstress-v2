# ============================================================
# 10. FUNCTION TO CREATE SIGNIFICANCE LABELS
# ============================================================

p_to_stars <- function(p) {
  
  case_when(
    is.na(p) ~ "",
    p <= 0.0001 ~ "****",
    p <= 0.001  ~ "***",
    p <= 0.01   ~ "**",
    p <= 0.05   ~ "*",
    TRUE        ~ ""
  )
}


# ============================================================
# 11. UNTREATED COMPARISONS
#
# These are retained as a separate statistical output.
#
# ANOVA:
#   emmeans treatment-vs-control contrasts
#   Holm adjustment
#
# Kruskal-Wallis:
#   Dunn comparisons against Untreated
#   Holm adjustment
# ============================================================

get_untreated_stats <- function(data, outcome) {
  
  
  dat <- data %>%
    select(
      Test,
      all_of(outcome)
    ) %>%
    rename(
      Value = all_of(outcome)
    ) %>%
    filter(
      !is.na(Value)
    )
  
  
  dat$Test <- droplevels(dat$Test)
  
  
  model <- lm(
    Value ~ Test,
    data = dat
  )
  
  
  residuals_model <- residuals(model)
  
  
  if (
    length(residuals_model) >= 3 &&
    length(residuals_model) <= 5000
  ) {
    
    normality_p <- shapiro.test(
      residuals_model
    )$p.value
    
  } else {
    
    normality_p <- NA_real_
    
  }
  
  
  use_anova <- !is.na(normality_p) &&
    normality_p > 0.05
  
  
  # ==========================================================
  # ANOVA BRANCH
  # ==========================================================
  
  if (use_anova) {
    
    emm <- emmeans(
      model,
      ~ Test
    )
    
    
    comparisons <- contrast(
      emm,
      method = "trt.vs.ctrl",
      ref = "Untreated",
      adjust = "holm"
    ) %>%
      as.data.frame() %>%
      as_tibble()
    
    
    return(
      comparisons %>%
        mutate(
          Outcome = outcome,
          test_method = "ANOVA / emmeans",
          significance = p_to_stars(p.value)
        )
    )
    
  }
  
  
  # ==========================================================
  # KRUSKAL-WALLIS / DUNN BRANCH
  # ==========================================================
  
  dunn_raw <- FSA::dunnTest(
    Value ~ Test,
    data = dat,
    method = "none"
  )$res %>%
    as_tibble()
  
  
  # Extract treatment names
  
  dunn_pairs <- strsplit(
    as.character(dunn_raw$Comparison),
    " - ",
    fixed = TRUE
  )
  
  
  dunn_group1 <- map_chr(
    dunn_pairs,
    ~ .x[1]
  )
  
  dunn_group2 <- map_chr(
    dunn_pairs,
    ~ .x[2]
  )
  
  
  untreated_comparisons <- dunn_raw %>%
    mutate(
      group1 = dunn_group1,
      group2 = dunn_group2
    ) %>%
    filter(
      group1 == "Untreated" |
        group2 == "Untreated"
    ) %>%
    mutate(
      p.value = p.adjust(
        P.unadj,
        method = "holm"
      ),
      Outcome = outcome,
      test_method = "Kruskal-Wallis / Dunn",
      significance = p_to_stars(p.value)
    )
  
  
  untreated_comparisons
  
}


