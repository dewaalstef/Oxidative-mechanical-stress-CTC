# ------------------------------------------------------------------
# Other way of displaying data follows, which includes the live/dead 
# separation
# ------------------------------------------------------------------


# 3. Median and IQR

summary_data <- nucleus_data %>%
  group_by(Treatment, Dead, Distance) %>%
  summarise(
    median = median(Immune_cells, na.rm = TRUE),
    Q1 = quantile(Immune_cells, 0.25, na.rm = TRUE),
    Q3 = quantile(Immune_cells, 0.75, na.rm = TRUE),
    .groups = "drop"
  )


# 4. Common y-axis

y_max <- ceiling(
  max(nucleus_data$Immune_cells, na.rm = TRUE) / 5
) * 5


# 5. Plot

p <- ggplot(
  nucleus_data,
  aes(
    x = Distance,
    y = Immune_cells,
    group = Tumour_ID,
    colour = Condition
  )
) +
  
  # Individual tumour-cell trajectories
  geom_line(
    alpha = 0.30,
    linewidth = 1.4
  ) +
  
  # Individual measurements
  geom_point(
    alpha = 0.50,
    size = 1.6
  ) +
  
  # Median
  geom_point(
    data = summary_data,
    aes(
      x = Distance,
      y = median
    ),
    colour = "black",
    size = 4,
    inherit.aes = FALSE
  ) +
  
  # IQR
  geom_errorbar(
    data = summary_data,
    aes(
      x = Distance,
      ymin = Q1,
      ymax = Q3
    ),
    colour = "black",
    width = 0.12,
    linewidth = 0.8,
    inherit.aes = FALSE
  ) +
  
  scale_colour_manual(
    values = condition_colours
  ) +
  
  # Same y-axis across every panel
  scale_y_continuous(
    limits = c(0, y_max),
    breaks = seq(0, y_max, by = 5),
    expand = expansion(mult = c(0, 0.05))
  ) +
  
  # Separate treatment columns and alive/dead rows
  facet_grid(
    Dead ~ Treatment
  ) +
  
  labs(
    x = "Distance from tumour-cell nucleus (µm)",
    y = "Number of immune cells within the indicated distance",
    # colour = "Mouse"
  ) +
  
  theme_classic() +
  
  theme(
    text = element_text(size = 20),
    axis.title = element_text(size = 20),
    axis.text = element_text(size = 20),
    strip.text = element_text(size = 20),
    panel.grid.major.y = element_line(),
    panel.grid.minor.y = element_blank(),
    legend.position = "none"
  )


# Display
p

