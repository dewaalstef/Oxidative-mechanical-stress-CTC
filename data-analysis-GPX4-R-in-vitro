# ============================================================
# 13. PLOT FUNCTION
# ============================================================
#
# Plot:
#   - mean across experimental replicates
#   - SD across experimental replicates
#   - individual replicate means
#   - treatment colours
#   - significant Tukey or Dunn-Holm brackets
#
# Data displayed are normalised to RPMI-control.
# ============================================================

plot_outcome <- function(outcome_name) {
  
  # ----------------------------------------------------------
  # Data for this outcome
  # ----------------------------------------------------------
  
  dat <- plot_data_normalised %>%
    filter(
      Outcome == outcome_name
    )
  
  if (nrow(dat) == 0) {
    stop(
      paste0(
        "No data found for outcome: ",
        outcome_name
      )
    )
  }
  
  # ----------------------------------------------------------
  # Summary statistics
  # ----------------------------------------------------------
  
  summary_dat <- dat %>%
    group_by(Treatment) %>%
    summarise(
      mean_value = mean(
        Value,
        na.rm = TRUE
      ),
      
      sd_value = sd(
        Value,
        na.rm = TRUE
      ),
      
      n = sum(
        !is.na(Value)
      ),
      
      .groups = "drop"
    )
  
  # ----------------------------------------------------------
  # Remove completely missing treatment groups
  # ----------------------------------------------------------
  
  summary_dat <- summary_dat %>%
    filter(
      !is.na(mean_value)
    )
  
  # ----------------------------------------------------------
  # Statistical result for this outcome
  # ----------------------------------------------------------
  
  overall <- overall_results %>%
    filter(
      Outcome == outcome_name
    )
  
  if (nrow(overall) != 1) {
    stop(
      paste0(
        "Could not find exactly one statistical result for: ",
        outcome_name
      )
    )
  }
  
  test_method <- overall$test_method[1]
  overall_p <- overall$p_value[1]
  
  # ----------------------------------------------------------
  # Overall statistical annotation
  # ----------------------------------------------------------
  
  if (test_method == "ANOVA") {
    
    overall_label <- paste0(
      "ANOVA: p = ",
      format.pval(
        overall_p,
        digits = 3,
        eps = 0.001
      )
    )
    
  } else {
    
    overall_label <- paste0(
      "Kruskal-Wallis: p = ",
      format.pval(
        overall_p,
        digits = 3,
        eps = 0.001
      )
    )
    
  }
  
  # ----------------------------------------------------------
  # Significant pairwise comparisons
  # ----------------------------------------------------------
  
  sig_dat <- sig_comparisons %>%
    filter(
      Outcome == outcome_name
    )
  
  # ----------------------------------------------------------
  # Calculate y positions
  # ----------------------------------------------------------
  
  finite_values <- dat$Value[
    is.finite(dat$Value)
  ]
  
  if (length(finite_values) == 0) {
    stop(
      paste0(
        "No finite values available for outcome: ",
        outcome_name
      )
    )
  }
  
  y_min <- min(
    finite_values,
    na.rm = TRUE
  )
  
  y_max <- max(
    finite_values,
    na.rm = TRUE
  )
  
  y_range <- y_max - y_min
  
  if (
    !is.finite(y_range) ||
    y_range == 0
  ) {
    y_range <- max(
      abs(y_max),
      1,
      na.rm = TRUE
    )
  }
  
  # ----------------------------------------------------------
  # Overall-test label position
  # ----------------------------------------------------------
  
  overall_y <- y_max +
    0.08 * y_range
  
  # ----------------------------------------------------------
  # Significance bracket positions
  # ----------------------------------------------------------
  
  if (nrow(sig_dat) > 0) {
    
    sig_dat <- sig_dat %>%
      mutate(
        y_position =
          y_max +
          (row_number() + 1) *
          0.12 *
          y_range
      )
    
  }
  
  # ----------------------------------------------------------
  # Plot
  # ----------------------------------------------------------
  
  p <- ggplot(
    summary_dat,
    aes(
      x = Treatment,
      y = mean_value
    )
  ) +
    
    # Mean bars: same treatment colours as the individual dots
    geom_col(
      aes(fill = Treatment),
      width = 0.7,
      colour = "black",
      alpha = 0.8
    ) +
    
    # SD error bars
    geom_errorbar(
      aes(
        ymin = mean_value - sd_value,
        ymax = mean_value + sd_value
      ),
      width = 0.2,
      na.rm = TRUE
    ) +
    
    # Individual replicate means with treatment-coloured fill
    # and a black outline
    geom_point(
      data = dat,
      aes(
        x = Treatment,
        y = Value,
        fill = Treatment
      ),
      shape = 21,
      colour = "black",
      position = position_jitter(
        width = 0.08,
        height = 0
      ),
      size = 3,
      na.rm = TRUE
    ) +
    
    # Same treatment colours for bars and dots
    scale_fill_manual(
      values = treatment_colours,
      drop = FALSE
    ) +
    
    # Labels
    labs(
      title = outcome_name,
      # subtitle = overall_label,
      x = NULL,
      y = "Relative to RPMI-control (%)"
    ) +
    
    theme_classic(
      base_size = 16
    ) +
    
    theme(
      axis.line = element_line(
        colour = "black",
        linewidth = 1
      ),
      
      axis.ticks = element_line(
        colour = "black",
        linewidth = 0.8
      ),
      
      axis.ticks.length = unit(
        0.2,
        "cm"
      ),
      
      axis.text.x = element_text(
        angle = 45,
        hjust = 1,
        # Increase size below to give x titles
        size = 0
      ),
      
      plot.title = element_text(
        face = "bold",
        size = 10
      ),
      
      plot.subtitle = element_text(
        size = 13
      ),
      
      legend.position = "right",
      
      plot.margin = margin(
        10,
        20,
        10,
        10
      )
    )
  
  # ----------------------------------------------------------
  # Add significant pairwise comparisons
  # ----------------------------------------------------------
  
  if (nrow(sig_dat) > 0) {
    
    bracket_height <- 0.025 *
      y_range
    
    p <- p +
      
      # Horizontal bracket
      geom_segment(
        data = sig_dat,
        aes(
          x = x_left,
          xend = x_right,
          y = y_position,
          yend = y_position
        ),
        inherit.aes = FALSE,
        linewidth = 0.6
      ) +
      
      # Left vertical bracket
      geom_segment(
        data = sig_dat,
        aes(
          x = x_left,
          xend = x_left,
          y = y_position,
          yend =
            y_position -
            bracket_height
        ),
        inherit.aes = FALSE,
        linewidth = 0.6
      ) +
      
      # Right vertical bracket
      geom_segment(
        data = sig_dat,
        aes(
          x = x_right,
          xend = x_right,
          y = y_position,
          yend =
            y_position -
            bracket_height
        ),
        inherit.aes = FALSE,
        linewidth = 0.6
      ) +
      
      # Significance label
      geom_text(
        data = sig_dat,
        aes(
          x = (x_left + x_right) / 2,
          y = y_position,
          label = significance
        ),
        inherit.aes = FALSE,
        vjust = -0.25,
        size = 5
      )
    
  }
  
  # ----------------------------------------------------------
  # Make enough room above the plot for annotations
  # ----------------------------------------------------------
  
  if (nrow(sig_dat) > 0) {
    
    highest_annotation <- max(
      sig_dat$y_position,
      na.rm = TRUE
    )
    
    p <- p +
      coord_cartesian(
        ylim = c(
          NA,
          highest_annotation +
            0.12 * y_range
        ),
        clip = "off"
      )
    
  } else {
    
    p <- p +
      coord_cartesian(
        ylim = c(
          NA,
          overall_y +
            0.08 * y_range
        ),
        clip = "off"
      )
    
  }
  
  return(p)
}



