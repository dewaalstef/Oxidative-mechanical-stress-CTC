# ============================================================
# 9. STATISTICAL ANALYSIS FUNCTION
# ============================================================
#
# Automatically chooses:
#
#   approximately normal residuals
#       -> ANOVA + Tukey
#
#   non-normal residuals
#       -> Kruskal-Wallis + Dunn-Holm
#
# Normality is tested on MODEL RESIDUALS, not separately within
# each treatment. This is appropriate here because there are
# only a small number of experimental replicates per treatment.
# ============================================================

run_model <- function(
    outcome_name,
    data = replicate_means
) {
  
  # ----------------------------------------------------------
  # Prepare data
  # ----------------------------------------------------------
  
  dat <- data %>%
    select(
      Treatment,
      all_of(outcome_name)
    ) %>%
    rename(
      Value = all_of(outcome_name)
    ) %>%
    filter(
      !is.na(Value)
    ) %>%
    mutate(
      Treatment = droplevels(Treatment)
    )
  
  
  # ----------------------------------------------------------
  # Basic checks
  # ----------------------------------------------------------
  
  if (nrow(dat) < 3) {
    
    stop(
      paste0(
        "Not enough observations for outcome: ",
        outcome_name
      )
    )
    
  }
  
  
  if (nlevels(dat$Treatment) < 2) {
    
    stop(
      paste0(
        "Fewer than two treatment groups available for outcome: ",
        outcome_name
      )
    )
    
  }
  
  
  # ----------------------------------------------------------
  # Linear model
  # ----------------------------------------------------------
  
  model <- lm(
    Value ~ Treatment,
    data = dat
  )
  
  
  # ----------------------------------------------------------
  # Normality of residuals
  # ----------------------------------------------------------
  
  residuals_model <- residuals(model)
  
  
  # Check whether residuals contain variation
  
  if (
    length(residuals_model) >= 3 &&
    length(residuals_model) <= 5000 &&
    length(unique(residuals_model)) > 1
  ) {
    
    shapiro_result <- shapiro.test(
      residuals_model
    )
    
    normality_p <- shapiro_result$p.value
    
  } else {
    
    normality_p <- NA_real_
    
  }
  
  
  # ----------------------------------------------------------
  # Check whether the outcome contains any variation
  # ----------------------------------------------------------
  
  if (
    length(unique(dat$Value)) <= 1
  ) {
    
    warning(
      paste0(
        "Outcome has no variation across replicate means: ",
        outcome_name,
        ". Statistical testing is not possible."
      )
    )
    
    treatment_result <- tibble(
      Outcome = outcome_name,
      test_method = "No variation",
      normality_p = normality_p,
      statistic = NA_real_,
      df = NA_real_,
      p_value = NA_real_
    )
    
    return(
      list(
        model = model,
        
        treatment_result = treatment_result,
        
        pairwise = tibble(),
        
        emmeans = NULL,
        
        normality = tibble(
          Outcome = outcome_name,
          normality_test =
            "Shapiro-Wilk on model residuals",
          normality_p = normality_p,
          distribution = "No residual variation"
        )
      )
    )
  }
  
  
  # ----------------------------------------------------------
  # Select statistical approach
  # ----------------------------------------------------------
  
  use_anova <- (
    !is.na(normality_p) &&
      normality_p > 0.05
  )
  
  
  # ==========================================================
  # ANOVA + Tukey
  # ==========================================================
  
  if (use_anova) {
    
    anova_table <- anova(model)
    
    overall_p <- anova_table$`Pr(>F)`[1]
    
    statistic <- anova_table$`F value`[1]
    
    df_value <- anova_table$Df[1]
    
    
    treatment_result <- tibble(
      Outcome = outcome_name,
      test_method = "ANOVA",
      normality_p = normality_p,
      statistic = statistic,
      df = df_value,
      p_value = overall_p
    )
    
    
    # --------------------------------------------------------
    # Estimated marginal means
    # --------------------------------------------------------
    
    emm <- emmeans(
      model,
      ~ Treatment
    )
    
    
    # --------------------------------------------------------
    # Tukey-adjusted pairwise comparisons
    # --------------------------------------------------------
    
    pairwise_raw <- contrast(
      emm,
      method = "pairwise",
      adjust = "tukey"
    ) %>%
      as.data.frame()
    
    
    pairwise <- pairwise_raw %>%
      mutate(
        Outcome = outcome_name,
        test_method = "Tukey"
      )
    
    
    # --------------------------------------------------------
    # Exact pair lookup
    #
    # This avoids problems caused by treatment names
    # containing hyphens, %, µM, etc.
    # --------------------------------------------------------
    
    pair_lookup <- tibble(
      group1 = levels(dat$Treatment)
    ) %>%
      tidyr::crossing(
        group2 = levels(dat$Treatment)
      ) %>%
      filter(
        match(
          group1,
          levels(dat$Treatment)
        ) <
          match(
            group2,
            levels(dat$Treatment)
          )
      ) %>%
      mutate(
        contrast = paste(
          group1,
          group2,
          sep = " - "
        )
      )
    
    
    pairwise <- pairwise %>%
      left_join(
        pair_lookup,
        by = "contrast"
      )
    
    
    return(
      list(
        model = model,
        
        treatment_result = treatment_result,
        
        pairwise = pairwise,
        
        emmeans = as.data.frame(emm),
        
        normality = tibble(
          Outcome = outcome_name,
          normality_test =
            "Shapiro-Wilk on model residuals",
          normality_p = normality_p,
          distribution =
            "Approximately normal"
        )
      )
    )
  }
  
  
  # ==========================================================
  # Kruskal-Wallis + Dunn-Holm
  # ==========================================================
  
  kw_result <- kruskal.test(
    Value ~ Treatment,
    data = dat
  )
  
  
  treatment_result <- tibble(
    Outcome = outcome_name,
    test_method = "Kruskal-Wallis",
    normality_p = normality_p,
    statistic = unname(
      kw_result$statistic
    ),
    df = unname(
      kw_result$parameter
    ),
    p_value = kw_result$p.value
  )
  
  
  # ----------------------------------------------------------
  # Dunn test
  # ----------------------------------------------------------
  
  dunn_raw <- FSA::dunnTest(
    Value ~ Treatment,
    data = dat,
    method = "holm"
  )$res
  
  
  # ----------------------------------------------------------
  # Create exact pair lookup
  # ----------------------------------------------------------
  
  pair_lookup <- tibble(
    group1 = levels(dat$Treatment)
  ) %>%
    tidyr::crossing(
      group2 = levels(dat$Treatment)
    ) %>%
    filter(
      match(
        group1,
        levels(dat$Treatment)
      ) <
        match(
          group2,
          levels(dat$Treatment)
        )
    ) %>%
    mutate(
      Comparison = paste(
        group1,
        group2,
        sep = " - "
      )
    )
  
  
  # ----------------------------------------------------------
  # Standardise Dunn output
  #
  # IMPORTANT:
  # FSA::dunnTest() stores the Holm-adjusted p-value in P.adj.
  # We rename it to p.value so downstream plotting works
  # identically for Tukey and Dunn results.
  # ----------------------------------------------------------
  
  pairwise <- dunn_raw %>%
    left_join(
      pair_lookup,
      by = "Comparison"
    ) %>%
    mutate(
      Outcome = outcome_name,
      test_method = "Dunn-Holm",
      p.value = P.adj
    )
  
  
  return(
    list(
      model = model,
      
      treatment_result = treatment_result,
      
      pairwise = pairwise,
      
      emmeans = NULL,
      
      normality = tibble(
        Outcome = outcome_name,
        normality_test =
          "Shapiro-Wilk on model residuals",
        normality_p = normality_p,
        distribution = "Non-normal"
      )
    )
  )
}


