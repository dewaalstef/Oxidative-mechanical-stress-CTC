# ============================================================
# 11. SIGNIFICANCE STAR FUNCTION
# ============================================================

p_to_stars <- function(p) {
  
  case_when(
    is.na(p) ~ "",
    p < 0.0001 ~ "****",
    p < 0.001  ~ "***",
    p < 0.01   ~ "**",
    p < 0.05   ~ "*",
    TRUE       ~ "ns"
  )
  
}


# ============================================================
# 12. PREPARE SIGNIFICANT PAIRWISE COMPARISONS
# ============================================================
#
# Tukey p-values are Tukey-adjusted.
# Dunn p-values are Holm-adjusted.
#
# Only significant comparisons are displayed on plots.
#
# IMPORTANT:
# This filter is based on the PAIRWISE p-value.
# It does not require the overall ANOVA/Kruskal-Wallis
# p-value to be < 0.05.
# ============================================================

if (show_significance) {
  
  sig_comparisons <- pairwise_results %>%
    filter(
      !is.na(p.value),
      p.value < 0.05,
      !is.na(group1),
      !is.na(group2)
    ) %>%
    mutate(
      significance = p_to_stars(p.value),
      
      x1 = match(
        group1,
        treatment_order
      ),
      
      x2 = match(
        group2,
        treatment_order
      )
    ) %>%
    filter(
      !is.na(x1),
      !is.na(x2),
      x1 != x2
    ) %>%
    mutate(
      x_left = pmin(
        x1,
        x2
      ),
      
      x_right = pmax(
        x1,
        x2
      )
    ) %>%
    arrange(
      Outcome,
      x_left,
      x_right
    )
  
} else {
  
  sig_comparisons <- tibble()
  
}


