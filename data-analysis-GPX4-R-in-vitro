# ============================================================
# 15. SINGLE-CELL DISTRIBUTION / VIOLIN PLOTS
# ============================================================
#
# These plots are purely descriptive.
#
# They show:
#   - violin = distribution of individual cells/puncta
#   - boxplot = median + IQR
#   - red diamond = mean
#   - coloured points = individual observations
#
# NO STATISTICAL TESTS OR SIGNIFICANCE ANNOTATIONS ARE
# APPLIED TO THESE PLOTS.
# ============================================================

plot_single_cell <- function(outcome_name) {
  
  dat <- Data_analysis_GPX4 %>%
    filter(
      !is.na(.data[[outcome_name]])
    )
  
  
  if (nrow(dat) == 0) {
    
    stop(
      paste0(
        "No data found for outcome: ",
        outcome_name
      )
    )
    
  }
  
  
  ggplot(
    dat,
    aes(
      x = Treatment,
      y = .data[[outcome_name]]
    )
  ) +
    
    # --------------------------------------------------------
  # Violin: distribution of individual observations
  # --------------------------------------------------------
  
  geom_violin(
    aes(
      fill = Treatment
    ),
    alpha = 0.35,
    trim = FALSE,
    colour = "black"
  ) +
    
    # --------------------------------------------------------
  # Boxplot
  # --------------------------------------------------------
  
  geom_boxplot(
    width = 0.12,
    coef = Inf,
    outlier.shape = NA,
    fill = "white",
    colour = "black"
  ) +
    
    # --------------------------------------------------------
  # Mean
  # --------------------------------------------------------
  
  stat_summary(
    fun = mean,
    geom = "point",
    shape = 18,
    size = 3,
    colour = "red"
  ) +
    
    # --------------------------------------------------------
  # Individual observations
  # --------------------------------------------------------
  
  geom_jitter(
    aes(
      colour = Treatment
    ),
    width = 0.12,
    height = 0,
    alpha = 0.7,
    size = 1.8
  ) +
    
    # --------------------------------------------------------
  # Treatment colours
  # --------------------------------------------------------
  
  scale_fill_manual(
    values = treatment_colours,
    drop = FALSE
  ) +
    
    scale_colour_manual(
      values = treatment_colours,
      drop = FALSE
    ) +
    
    # --------------------------------------------------------
  # Labels
  # --------------------------------------------------------
  
  labs(
    title = outcome_name,
    x = NULL,
    y = outcome_name
  ) +
    
    # --------------------------------------------------------
  # Theme
  # --------------------------------------------------------
  
  theme_classic(
    base_size = 16
  ) +
    
    theme(
      axis.text.x = element_text(
        size = 12,
        angle = 45,
        hjust = 1
      ),
      
      axis.text.y = element_text(
        size = 14
      ),
      
      axis.title.x = element_text(
        size = 16
      ),
      
      axis.title.y = element_text(
        size = 16
      ),
      
      plot.title = element_text(
        face = "bold"
      ),
      
      legend.position = "none"
    )
}


