# ------------------------------------------------------------
# Statistical analysis for all outcomes
# 1. Fit outcome ~ Treatment and test residual normality (Shapiro-Wilk)
# 2. Approximately normal residuals: one-way ANOVA + Tukey HSD
# 3. Non-normal residuals: Kruskal-Wallis + Dunn test (Holm adjustment)
# ------------------------------------------------------------

library(FSA)       # dunnTest

# Use only rows with a treatment and a non-missing value for the outcome.
run_statistical_test <- function(outcome_name, data = Data_analysis_4HNE) {
  dat <- data %>%
    dplyr::select(Treatment, all_of(outcome_name)) %>%
    dplyr::rename(Value = all_of(outcome_name)) %>%
    dplyr::filter(!is.na(Treatment), !is.na(Value)) %>%
    droplevels()

  if (n_distinct(dat$Treatment) < 2) {
    warning("Skipping ", outcome_name, ": fewer than two treatment groups with data.")
    return(list(
      omnibus = tibble(Outcome = outcome_name, Test = NA_character_,
                       Residual_Shapiro_p = NA_real_, p.value = NA_real_),
      pairwise = tibble(Outcome = character(), group1 = character(),
                        group2 = character(), p.value = numeric(),
                        Method = character())
    ))
  }

  # Use short internal group labels so treatment names containing hyphens
  # do not make pairwise-comparison labels ambiguous.
  treatment_labels <- unique(as.character(dat$Treatment))
  internal_labels <- paste0("Group", seq_along(treatment_labels))
  label_map <- stats::setNames(treatment_labels, internal_labels)
  dat$Treatment_test <- factor(
    as.character(dat$Treatment),
    levels = treatment_labels,
    labels = internal_labels
  )

  # Residual normality is assessed from the one-way linear model.
  lm_model <- lm(Value ~ Treatment_test, data = dat)
  residuals_model <- residuals(lm_model)
  shapiro_p <- if (length(residuals_model) >= 3 &&
                   length(residuals_model) <= 5000 &&
                   sd(residuals_model) > 0) {
    shapiro.test(residuals_model)$p.value
  } else {
    NA_real_
  }

  # If Shapiro-Wilk cannot be computed, use the non-parametric branch conservatively.
  use_anova <- !is.na(shapiro_p) && shapiro_p >= 0.05

  if (use_anova) {
    aov_model <- aov(Value ~ Treatment_test, data = dat)
    aov_table <- summary(aov_model)[[1]]
    omnibus_p <- aov_table[["Pr(>F)"]][1]

    tukey_table <- as.data.frame(TukeyHSD(aov_model, "Treatment_test")$Treatment_test)
    tukey_table$contrast <- rownames(tukey_table)
    pairwise <- tibble(
      Outcome = outcome_name,
      group1 = unname(label_map[sub("-.*$", "", tukey_table$contrast)]),
      group2 = unname(label_map[sub("^.*-", "", tukey_table$contrast)]),
      p.value = tukey_table$`p adj`,
      Method = "Tukey"
    )
    test_name <- "One-way ANOVA"
  } else {
    kw <- kruskal.test(Value ~ Treatment_test, data = dat)
    omnibus_p <- kw$p.value

    dunn_result <- FSA::dunnTest(Value ~ Treatment_test, data = dat, method = "holm")$res
    pairwise <- tibble(
      Outcome = outcome_name,
      group1 = unname(label_map[sub(" - .*", "", dunn_result$Comparison)]),
      group2 = unname(label_map[sub("^.* - ", "", dunn_result$Comparison)]),
      p.value = dunn_result$P.adj,
      Method = "Dunn-Holm"
    )
    test_name <- "Kruskal-Wallis"
  }

  list(
    omnibus = tibble(
      Outcome = outcome_name,
      Test = test_name,
      Residual_Shapiro_p = shapiro_p,
      p.value = omnibus_p
    ),
    pairwise = pairwise
  )
}

statistical_results <- lapply(outcomes, run_statistical_test)

# Omnibus test results and Benjamini-Hochberg FDR correction across outcomes.
anova_results <- dplyr::bind_rows(lapply(statistical_results, `[[`, "omnibus")) %>%
  mutate(
    p_adjusted = p.adjust(p.value, method = "BH"),
    significant_FDR = !is.na(p_adjusted) & p_adjusted < 0.05
  )

# Pairwise comparisons. Tukey-adjusted p-values are used for ANOVA outcomes;
# Holm-adjusted p-values are used for Dunn tests following Kruskal-Wallis.
pairwise_results <- dplyr::bind_rows(lapply(statistical_results, `[[`, "pairwise"))

View(anova_results)
View(pairwise_results)

