# Plot graphs as means per Replicate + Scan combination with significance

# Calculate means per Treatment and combined Replicate_Scan group.
replicate_means <- Data_analysis_4HNE %>%
  group_by(Treatment, Replicate_Scan) %>%
  summarise(
    across(all_of(outcomes), ~ mean(.x, na.rm = TRUE)),
    .groups = "drop"
  )

plot_data <- replicate_means %>%
  pivot_longer(
    cols = all_of(outcomes),
    names_to = "Outcome",
    values_to = "Value"
  ) %>%
  mutate(Treatment = factor(Treatment, levels = treatment_order))

# Normalize each Replicate_Scan group to its own RPMI-control value.
replicate_means_normalised <- replicate_means %>%
  group_by(Replicate_Scan) %>%
  mutate(
    across(
      all_of(outcomes),
      ~ {
        control_value <- .x[Treatment == "RPMI-control"]
        if (length(control_value) == 0 || is.na(control_value[1]) || control_value[1] == 0) {
          NA_real_
        } else {
          .x / control_value[1] * 100
        }
      }
    )
  ) %>%
  ungroup()

plot_data_normalised <- replicate_means_normalised %>%
  pivot_longer(
    cols = all_of(outcomes),
    names_to = "Outcome",
    values_to = "Value"
  ) %>%
  mutate(Treatment = factor(Treatment, levels = treatment_order))

# Significant pairwise comparisons from the appropriate test for each outcome.
if (show_significance) {
  sig_comparisons <- pairwise_results %>%
    filter(!is.na(p.value), p.value < 0.05) %>%
    mutate(
      significance = case_when(
        p.value < 0.0001 ~ "****",
        p.value < 0.001  ~ "***",
        p.value < 0.01   ~ "**",
        p.value < 0.05   ~ "*"
      )
    )
} else {
  sig_comparisons <- tibble()
}

# Function to create plot
plot_outcome <- function(outcome_name) {
  
  # Data for this outcome
  dat <- plot_data_normalised %>%
    filter(Outcome == outcome_name)
  
  if (nrow(dat) == 0) {
    stop(
      paste0(
        "No data found for outcome: ",
        outcome_name,
        "\nCheck that the outcome name exactly matches your data."
      )
    )
  }
  
  # Mean and SD across the Replicate + Scan combinations
  summary_dat <- dat %>%
    group_by(Treatment) %>%
    summarise(
      mean_value = mean(Value, na.rm = TRUE),
      sd_value = sd(Value, na.rm = TRUE),
      .groups = "drop"
    )
  
  if (all(is.na(summary_dat$mean_value))) {
    stop(
      paste0(
        "All values are NA for outcome: ",
        outcome_name,
        ". Check the outcome column in Data_analysis_4HNE."
      )
    )
  }
  
  # Significant Tukey comparisons for this outcome
  if (show_significance) {
    
    sig_dat <- sig_comparisons %>%
      filter(Outcome == outcome_name) %>%
      filter(
        group1 %in% treatment_order,
        group2 %in% treatment_order
      ) %>%
      mutate(
        x1 = match(group1, treatment_order),
        x2 = match(group2, treatment_order)
      ) %>%
      arrange(x1, x2)
    
  } else {
    
    sig_dat <- tibble()
    
  }
  
  # Set y-position for significance brackets
  if (nrow(sig_dat) > 0) {
    
    y_max <- max(summary_dat$mean_value + summary_dat$sd_value,
                 na.rm = TRUE)
    
    y_range <- y_max - min(summary_dat$mean_value, na.rm = TRUE)
    
    if (y_range == 0) {
      y_range <- y_max
    }
    
    sig_dat <- sig_dat %>%
      mutate(
        y_position = y_max + row_number() * y_range * 0.10
      )
  }
  
  # Plot
  p <- ggplot(summary_dat,
              aes(x = Treatment, y = mean_value)) +
    
    geom_col(
      aes(fill = Treatment),
      width = 0.7,
      colour = "black"
    ) +
    
    geom_errorbar(
      aes(
        ymin = mean_value - sd_value,
        ymax = mean_value + sd_value
      ),
      width = 0.2
    ) +
    
    # Individual Replicate + Scan means:
    # treatment-coloured dots with a black outline for contrast
    geom_point(
      data = dat,
      aes(
        x = Treatment,
        y = Value,
        fill = Treatment
      ),
      shape = 21,
      colour = "black",
      stroke = 0.7,
      position = position_jitter(
        width = 0.08,
        height = 0
      ),
      size = 3
    ) +
    
    # Use treatment colours for both bars and dots.
    # Treatments without a defined colour (e.g. NAC, if retained) appear grey.
    scale_fill_manual(
      values = treatment_colours,
      na.value = "grey70"
    ) +
    
    labs(
      title = outcome_name,
      x = NULL,
      y = "Relative to RPMI control (%)"
    ) +
    
    theme_classic(base_size = 16) +
    theme(
      axis.line = element_line(
        colour = "black",
        linewidth = 1
      ),
      axis.ticks = element_line(
        colour = "black",
        linewidth = 0.8
      ),
      axis.ticks.length = unit(0.2, "cm"),
      axis.text.x = element_text(
        angle = 45,
        hjust = 1
      ),
      plot.title = element_text(
        face = "bold"
      )
    )
  
  # Add significance brackets if there are any
  if (nrow(sig_dat) > 0) {
    
    p <- p +
      geom_segment(
        data = sig_dat,
        aes(
          x = x1,
          xend = x2,
          y = y_position,
          yend = y_position
        ),
        inherit.aes = FALSE
      ) +
      
      geom_segment(
        data = sig_dat,
        aes(
          x = x1,
          xend = x1,
          y = y_position,
          yend = y_position -
            (max(summary_dat$mean_value,
                 na.rm = TRUE) * 0.02)
        ),
        inherit.aes = FALSE
      ) +
      
      geom_segment(
        data = sig_dat,
        aes(
          x = x2,
          xend = x2,
          y = y_position,
          yend = y_position -
            (max(summary_dat$mean_value,
                 na.rm = TRUE) * 0.02)
        ),
        inherit.aes = FALSE
      ) +
      
      geom_text(
        data = sig_dat,
        aes(
          x = (x1 + x2) / 2,
          y = y_position,
          label = significance
        ),
        vjust = -0.3,
        inherit.aes = FALSE,
        size = 5
      )
  }
  
  p
}


