library(tidyverse)
library(readxl)

# ----------------------------------------------------------------
# 1. Import data
# ----------------------------------------------------------------

# add directory
data_immune_cancer_distance <- read_excel([...],
                                          sheet = "Data")
View(data_immune_cancer_distance)


# ----------------------------------------------------------------
# 2. Prepare variables
# ----------------------------------------------------------------

nucleus_data <- data_immune_cancer_distance %>%
  filter(`Expanded from (nucleus/cytoplasm)` == "nucleus") %>%
  mutate(
    Distance = factor(
      Distance,
      levels = c(5, 10, 20)
    ),
    
    Treatment = factor(
      Treatment,
      levels = c("control", "artesunate")
    ),
    
    Dead = factor(
      case_when(
        Dead == 0 ~ "Intact cytoplasm",
        Dead == 1 ~ "Loss of cytoplasm",
        TRUE ~ NA_character_
      ),
      levels = c("Intact cytoplasm", "Loss of cytoplasm")
    ),
    
    Tumour_ID = interaction(
      Mouse_id,
      img,
      Tumour_ROI
    ),
    
    Condition = case_when(
      Treatment == "control" &
        Dead == "Intact cytoplasm" ~ "Intact cytoplasm - Control",
      
      Treatment == "control" &
        Dead == "Loss of cytoplasm" ~ "Loss of cytoplasm - Control",
      
      Treatment == "artesunate" &
        Dead == "Intact cytoplasm" ~ "Intact cytoplasm - Artesunate",
      
      Treatment == "artesunate" &
        Dead == "Loss of cytoplasm" ~ "Loss of cytoplasm - Artesunate",
      
      TRUE ~ NA_character_
    ),
    
    Condition = factor(
      Condition,
      levels = c(
        "Intact cytoplasm - Control",
        "Loss of cytoplasm - Control",
        "Intact cytoplasm - Artesunate",
        "Loss of cytoplasm - Artesunate"
      )
    )
  )


# ----------------------------------------------------------------
# 3. Filter to Distance = 20
# ----------------------------------------------------------------

plot_data <- nucleus_data %>%
  filter(Distance == 20) %>%
  filter(!is.na(Condition))


# ----------------------------------------------------------------
# 4. Calculate median and interquartile range
# ----------------------------------------------------------------

summary_data <- plot_data %>%
  group_by(Condition) %>%
  summarise(
    median = median(Immune_cells, na.rm = TRUE),
    Q1 = quantile(Immune_cells, 0.25, na.rm = TRUE),
    Q3 = quantile(Immune_cells, 0.75, na.rm = TRUE),
    n = sum(!is.na(Immune_cells)),
    .groups = "drop"
  )


# ----------------------------------------------------------------
# 5. Define colours
# ----------------------------------------------------------------

condition_colours <- c(
  "Intact cytoplasm - Control" = "#F9918A",
  "Loss of cytoplasm - Control" = "#B8B8B8",
  "Intact cytoplasm - Artesunate" = "#08BC3E",
  "Loss of cytoplasm - Artesunate" = "#777777",
  "Control" = "#F9918A",
  "Artesunate" = "#08BC3E"
)


# ----------------------------------------------------------------
# 6. Set y-axis maximum & determine statistical test 
# ----------------------------------------------------------------

y_max <- ceiling(
  max(plot_data$Immune_cells, na.rm = TRUE)
)

# Prevent a zero-width axis if all observed counts are zero
if (y_max == 0) {
  y_max <- 5
}

# Check normality
normality_test <- shapiro.test(
  residuals(
    lm(Immune_cells ~ Condition, data = plot_data)
  )
)

# Select statistical test
if (normality_test$p.value > 0.05) {
  test_method <- "ANOVA"
} else {
  test_method <- "Kruskal-Wallis"
}

# ----------------------------------------------------------------
# 7. Create the single four-bar graph
# ----------------------------------------------------------------

p_v2 <- ggplot(
  summary_data,
  aes(
    x = Condition,
    y = median,
    fill = Condition
  )
) +
  
  # Median immune-cell count
  geom_col(
    width = 0.7,
    colour = "black",
    linewidth = 0.4
  ) +
  
  # Interquartile range
  geom_errorbar(
    aes(
      ymin = Q1,
      ymax = Q3
    ),
    width = 0.18,
    linewidth = 0.8,
    colour = "black"
  ) +
  
  # Condition-specific colours
  scale_fill_manual(
    values = condition_colours,
    drop = FALSE
  ) +
  
  # Y-axis
  scale_y_continuous(
    breaks = seq(0, y_max, by = 5),
    expand = expansion(mult = c(0, 0.05))
  ) +
  
  coord_cartesian(
    ylim = c(0, y_max)
  ) +
  
  # Labels
  scale_x_discrete(
    labels = c(
      "Intact cytoplasm - Control" = "Intact cytoplasm\nControl",
      "Loss of cytoplasm - Control" = "Loss of cytoplasm\nControl",
      "Intact cytoplasm - Artesunate" = "Intact cytoplasm\nArtesunate",
      "Loss of cytoplasm - Artesunate" = "Loss of cytoplasm\nArtesunate"
    ),
    drop = FALSE
  ) +
  
  labs(
    x = "Condition",
    y = "Number of CD45+ cells within 20 µm of the cancer cell"
  ) +
  
  theme_classic() +
  
  theme(
    text = element_text(size = 20),
    axis.title = element_text(size = 20),
    axis.text.x = element_text(
      size = 14,
      colour = "black",
      lineheight = 1.1
    ),
    axis.text.y = element_text(
      size = 20,
      colour = "black"
    ),
    panel.grid.major.y = element_line(
      colour = "grey85",
      linewidth = 0.4
    ),
    panel.grid.minor.y = element_blank(),
    legend.position = c(0.98, 0.98),
    legend.justification = c("right", "top"),
    legend.background = element_rect(
      fill = "white",
      colour = "black",
      linewidth = 0.4
    ),
    legend.title = element_blank(),
    legend.text = element_text(size = 20)
  )


# ----------------------------------------------------------------
# 8. Display graph
# ----------------------------------------------------------------

p_v2


# ----------------------------------------------------------------
# 9. Optional: inspect summary values
# ----------------------------------------------------------------

print(summary_data)


# ----------------------------------------------------------------
# 10. Compare all control versus all artesunate
#     (without cytoplasm subdivision)
# ----------------------------------------------------------------

# ----------------------------------------------------------------
# 10.1 Prepare combined treatment data
# ----------------------------------------------------------------

treatment_data <- plot_data %>%
  mutate(
    Treatment_group = factor(
      as.character(Treatment),
      levels = c("control", "artesunate"),
      labels = c("Control", "Artesunate")
    )
  )


# ----------------------------------------------------------------
# 10.2 Calculate median and interquartile range
# ----------------------------------------------------------------

treatment_summary <- treatment_data %>%
  group_by(Treatment_group) %>%
  summarise(
    median = median(Immune_cells, na.rm = TRUE),
    Q1 = quantile(Immune_cells, 0.25, na.rm = TRUE),
    Q3 = quantile(Immune_cells, 0.75, na.rm = TRUE),
    n = sum(!is.na(Immune_cells)),
    .groups = "drop"
  )


# ----------------------------------------------------------------
# 10.3 Calculate statistical significance
# ----------------------------------------------------------------

control_values <- treatment_data %>%
  filter(Treatment_group == "Control") %>%
  pull(Immune_cells) %>%
  na.omit()

artesunate_values <- treatment_data %>%
  filter(Treatment_group == "Artesunate") %>%
  pull(Immune_cells) %>%
  na.omit()


if (length(control_values) == 0 ||
    length(artesunate_values) == 0) {
  
  overall_p_treatment <- NA
  
} else {
  
  if (test_method == "ANOVA") {
    
    treatment_test <- aov(
      Immune_cells ~ Treatment_group,
      data = treatment_data
    )
    
    overall_p_treatment <- summary(
      treatment_test
    )[[1]][["Pr(>F)"]][1]
    
  } else if (test_method == "Kruskal-Wallis") {
    
    treatment_test <- kruskal.test(
      Immune_cells ~ Treatment_group,
      data = treatment_data
    )
    
    overall_p_treatment <- treatment_test$p.value
    
  } else {
    
    stop(
      "Unsupported test_method: ",
      test_method
    )
    
  }
}


# ----------------------------------------------------------------
# 10.4 Create dynamic overall-test label
# ----------------------------------------------------------------

if (test_method == "ANOVA") {
  
  test_name_treatment <- "ANOVA"
  
} else if (test_method == "Kruskal-Wallis") {
  
  test_name_treatment <- "Kruskal-Wallis"
  
} else {
  
  test_name_treatment <- test_method
  
}


if (is.na(overall_p_treatment)) {
  
  overall_label_treatment <- paste0(
    test_name_treatment,
    ": p = NA"
  )
  
} else if (overall_p_treatment < 0.001) {
  
  overall_label_treatment <- paste0(
    test_name_treatment,
    ": p < 0.001"
  )
  
} else {
  
  overall_label_treatment <- paste0(
    test_name_treatment,
    ": p = ",
    format.pval(
      overall_p_treatment,
      digits = 3,
      eps = 0.001
    )
  )
  
}


# ----------------------------------------------------------------
# 10.5 Set y-axis maximum
# ----------------------------------------------------------------

y_max_treatment <- ceiling(
  max(treatment_data$Immune_cells, na.rm = TRUE)
)

if (!is.finite(y_max_treatment) ||
    y_max_treatment == 0) {
  
  y_max_treatment <- 5
  
}

upper_limit_treatment <- y_max_treatment * 1.2


# ----------------------------------------------------------------
# 10.6 Create two-bar graph
# ----------------------------------------------------------------

p_treatment <- ggplot(
  treatment_summary,
  aes(
    x = Treatment_group,
    y = median,
    fill = Treatment_group
  )
) +
  
  # Median immune-cell count
  geom_col(
    width = 0.7,
    colour = "black",
    linewidth = 0.4
  ) +
  
  # Interquartile range
  geom_errorbar(
    aes(
      ymin = Q1,
      ymax = Q3
    ),
    width = 0.18,
    linewidth = 0.8,
    colour = "black"
  ) +
  
  # Treatment-specific colours
  scale_fill_manual(
    values = condition_colours,
    drop = FALSE
  ) +
  
  # Y-axis
  scale_y_continuous(
    breaks = seq(
      0,
      y_max_treatment,
      by = 5
    ),
    expand = expansion(
      mult = c(0, 0.05)
    )
  ) +
  
  # Treatment labels
  scale_x_discrete(
    labels = c(
      "Control" = "Control",
      "Artesunate" = "Artesunate"
    )
  ) +
  
  labs(
    x = "Treatment",
    y = "Number of CD45+ cells within 20 µm of the cancer cell"
  ) +
  
  # Overall statistical-test label
  annotate(
    "text",
    x = 1,
    y = upper_limit_treatment,
    label = overall_label_treatment,
    hjust = 0,
    vjust = 1,
    size = 20 / ggplot2::.pt
  ) +
  
  coord_cartesian(
    ylim = c(
      0,
      upper_limit_treatment
    ),
    clip = "off"
  ) +
  
  theme_classic() +
  
  theme(
    text = element_text(size = 20),
    axis.title = element_text(size = 20),
    axis.text.x = element_text(
      size = 20,
      colour = "black"
    ),
    axis.text.y = element_text(
      size = 20,
      colour = "black"
    ),
    panel.grid.major.y = element_line(
      colour = "grey85",
      linewidth = 0.4
    ),
    panel.grid.minor.y = element_blank(),
    legend.position = "none"
  )


# ----------------------------------------------------------------
# 10.7 Display graph
# ----------------------------------------------------------------

p_treatment


# ----------------------------------------------------------------
# 10.8 Inspect summary and statistical results
# ----------------------------------------------------------------

print(treatment_summary)

cat(
  "\nOverall treatment comparison:",
  test_name_treatment,
  "\np-value:",
  overall_p_treatment,
  "\n"
)
